{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "beats",
    "decision",
    "protected_non_actions",
    "future_book_risks",
    "escalation_curve",
    "writer_handoff",
    "verdict"
  ],
  "properties": {
    "beats": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "visible_action",
          "reader_effect",
          "evidence_boundary",
          "continuity_risk",
          "exit_condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "visible_action": {
            "type": "string",
            "minLength": 1
          },
          "reader_effect": {
            "type": "string",
            "minLength": 1
          },
          "evidence_boundary": {
            "type": "string",
            "minLength": 1
          },
          "continuity_risk": {
            "type": "string",
            "minLength": 1
          },
          "exit_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "protected_non_actions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "future_book_risks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "escalation_curve": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writer_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_inclusions",
        "prohibited_conclusions",
        "scene_boundary"
      ],
      "properties": {
        "required_inclusions": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_conclusions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scene_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verdict": {
      "enum": [
        "proceed",
        "retry",
        "escalate"
      ]
    }
  }
}
