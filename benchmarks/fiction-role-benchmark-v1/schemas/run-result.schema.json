{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "pack_version",
    "role",
    "attempt_id",
    "requested_route",
    "served_route",
    "routing_status",
    "usage_class",
    "packet_manifest_sha256",
    "started_at",
    "ended_at",
    "latency_ms",
    "settings",
    "status",
    "failures",
    "artifacts",
    "score"
  ],
  "properties": {
    "benchmark_id": {
      "const": "fiction-role-benchmark-v1"
    },
    "pack_version": {
      "const": "1.0.0"
    },
    "role": {
      "enum": [
        "showrunner",
        "writer",
        "editor",
        "reader",
        "researcher",
        "continuity",
        "mechanical-qa"
      ]
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_route": {
      "$ref": "#/$defs/route"
    },
    "served_route": {
      "anyOf": [
        {
          "$ref": "#/$defs/route"
        },
        {
          "type": "null"
        }
      ]
    },
    "routing_status": {
      "enum": [
        "verified_exact",
        "mismatch",
        "unverified",
        "not_started"
      ]
    },
    "usage_class": {
      "enum": [
        "low",
        "medium",
        "high",
        "extra-high",
        "extra-credit",
        "unknown"
      ]
    },
    "entitlement_or_cost_gate": {
      "type": "string"
    },
    "packet_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "settings": {
      "type": "object",
      "required": [
        "temperature",
        "reasoning",
        "max_output_tokens",
        "tool_access",
        "fresh_session"
      ],
      "properties": {
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "reasoning": {
          "type": "string"
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tool_access": {
          "type": "string"
        },
        "fresh_session": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "invalid",
        "not_started"
      ]
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failure"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cached_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "provider_reported_cost": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_total",
            "deterministic_penalty",
            "final_score",
            "scorer_count",
            "score_record_paths"
          ],
          "properties": {
            "human_total": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "deterministic_penalty": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "final_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "scorer_count": {
              "type": "integer",
              "minimum": 1
            },
            "score_record_paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ],
      "description": "Null before blind adjudication; populated only after score records are locked and identities revealed."
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "class",
        "message"
      ],
      "properties": {
        "class": {
          "enum": [
            "route_mismatch",
            "auth",
            "rate_limit",
            "entitlement",
            "timeout",
            "truncation",
            "empty_output",
            "schema",
            "instruction",
            "preservation",
            "hallucination",
            "citation",
            "continuity",
            "scope_creep",
            "quality",
            "other"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
