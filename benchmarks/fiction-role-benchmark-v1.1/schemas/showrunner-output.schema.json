{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "beats",
    "decision",
    "protected_non_actions",
    "escalation_curve",
    "verdict"
  ],
  "properties": {
    "beats": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "visible_action",
          "reader_effect",
          "continuity_risk",
          "exit_condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "visible_action": {
            "type": "string",
            "minLength": 1
          },
          "reader_effect": {
            "type": "string",
            "minLength": 1
          },
          "continuity_risk": {
            "type": "string",
            "minLength": 1
          },
          "exit_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "protected_non_actions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "escalation_curve": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "proceed",
        "retry",
        "escalate"
      ]
    }
  }
}
